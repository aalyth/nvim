{
  "elixir.pathToElixirLS": "/home/dimitar/elixir-ls/language_server.sh",
  "languageserver": {
    "haskell": {
      "command": "haskell-language-server-wrapper",
      "args": ["--lsp"],
      "rootPatterns": [
        ".stack.yaml",
        ".hie-bios",
        "BUILD.bazel",
        "cabal.config",
        "package.yaml"
      ],
      "filetypes": ["hs", "lhs", "haskell"]
    }
  },
  "clangd": {
    "filetypes": ["c", "cpp", "objc", "objcpp"],
    "arguments": [
      "--compile-commands-dir=."
    ]
  },
  "inlayHint.enable": false
}
